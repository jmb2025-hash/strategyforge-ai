        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">#FF0A0E14</item>
        <item name="android:navigationBarColor">#FF0A0E14</item>
    </style>
    <style name="Theme.StrategyForge.Starting" parent="Theme.SplashScreen">
