  "plan": {
    "schemaVersion": "1.0",
    "metadata": {
      "name": "Index dip score",
      "assetClass": "US_EQUITY",
      "timeframe": "1d",
      "createdBy": "IMPORTED",
      "direction": "LONG_ONLY",
      "description": "A new composite found in real daily history of SPY, QQQ and IWM 1998 to March 2021 (chosen on 1998-2012, confirmed unchanged on 2013-2021; also profitable on large stocks such as AAPL, BAC and GOOG). While a fund closes above its 50-day average, buy it when at least 2 of 4 oversold signals agree: the 2-day RSI under 10, the close in the bottom 20% of the day's range, the close under the lower Bollinger band (20, 2), and a 10-day closing low. Sell when the close is back above the 5-day average, after 20 days at most, or at a 15% stop. Up to 3 positions at about a third of equity each. About 7 in 10 trades win; it is invested only about a tenth of the time."
    },
    "universe": {
      "symbols": [
        "SPY",
        "QQQ",
        "IWM"
      ]
    },
    "dataRequirements": {
      "minimumHistoryBars": 60,
      "maximumQuoteAgeSeconds": 3600,
      "indicators": [
        {
          "id": "TREND",
          "type": "SMA",
          "period": 50
        },
        {
          "id": "R",
          "type": "RSI",
          "period": 2
        },
        {
          "id": "IBS20",
          "type": "LEVEL",
          "from": "LOW",
          "to": "HIGH",
          "ratio": 0.2
        },
        {
          "id": "BB",
          "type": "BOLLINGER_BANDS",
          "period": 20,
          "standardDeviations": 2
        },
        {
          "id": "LOW10",
          "type": "LOWEST",
          "period": 10,
          "source": "CLOSE"
        },
        {
          "id": "EXIT",
          "type": "SMA",
          "period": 5
        }
      ]
    },
    "entryRules": {
      "operator": "ALL",
      "conditions": [
        {
          "left": "CLOSE",
          "comparison": "GT",
          "right": "TREND"
        },
        {
          "operator": "AT_LEAST",
          "count": 2,
          "conditions": [
            {
              "left": "R",
              "comparison": "LT",
              "right": 10
            },
            {
              "left": "CLOSE",
              "comparison": "LT",
              "right": "IBS20"
            },
            {
              "left": "CLOSE",
              "comparison": "LT",
              "right": "BB.lower"
            },
            {
              "left": "CLOSE",
              "comparison": "LTE",
              "right": "LOW10"
            }
          ]
        }
      ]
    },
    "exitRules": {
      "stopLossPercent": 15,
      "takeProfitPercent": 30,
      "maximumHoldingBars": 20,
      "conditions": {
        "operator": "ANY",
        "conditions": [
          {
            "left": "CLOSE",
            "comparison": "GT",
            "right": "EXIT"
          }
        ]
      }
    },
    "positionSizing": {
      "method": "PERCENT_OF_EQUITY",
      "value": 32
    },
    "orderInstructions": {
      "orderType": "MARKET",
      "timeInForce": "GTC"
    },
    "riskLimits": {
      "maximumOpenPositions": 3,
      "maximumDailyTrades": 5,
      "maximumDailyLossPercent": 10,
      "maximumDrawdownPercent": 40,
      "maximumPositionPercent": 100,
      "allowShort": false
    },
    "inactivityConditions": [
      "STALE_MARKET_DATA",
      "MISSING_HISTORY",
      "PROVIDER_UNAVAILABLE"
    ]
  }
}