  "plan": {
    "schemaVersion": "1.0",
    "metadata": {
      "name": "BTC trend core",
      "assetClass": "CRYPTO",
      "timeframe": "1d",
      "createdBy": "IMPORTED",
      "direction": "LONG_ONLY",
      "description": "Found in real BTC/USD daily history 2018 to October 2026 (chosen on 2018-2022 by return per unit of drawdown, confirmed unchanged on 2023-2026). Hold BTC while the daily close is above its 100-day average; sell when it closes below, and wait in cash until it closes above again. One position, 95% of equity, a 30% emergency stop. It catches the big bull trends and steps aside in bear markets. Most trades are small losses when the price whipsaws around the average (about 1 in 4 trades wins); the winners are large."
    },
    "universe": {
      "symbols": [
        "BTC-USD"
      ]
    },
