  "plan": {
    "schemaVersion": "1.0",
    "metadata": {
      "name": "BTC trend pullback",
      "assetClass": "CRYPTO",
      "timeframe": "4h",
      "createdBy": "IMPORTED",
      "direction": "BOTH",
      "description": "Found in real BTC/USD history from January 2025 to October 2026. Trade only with the daily trend: while yesterday's daily close is above the 50-day average, buy when the 4-hour RSI(4) drops below 10 (a sharp dip); while it is below, sell short when the RSI(4) rises above 90 (a sharp spike). Exit when the RSI(4) crosses back through 50, after 10 days at most, or at a 5% stop. The daily trend decides the direction, so the plan switches between buying dips and selling rallies by itself. Chosen on 2025 data, then confirmed unchanged on 2026; neighbouring settings (40-50 day average, RSI threshold 10-12) were profitable too."
    },
    "universe": {
      "symbols": [
        "BTC-USD"
      ]
    },
    "dataRequirements": {
      "minimumHistoryBars": 30,
      "maximumQuoteAgeSeconds": 300,
      "indicators": [
        {
          "id": "DAY",
          "type": "PERIOD_LEVELS",
          "anchor": "DAY"
        },
        {
          "id": "TREND",
          "type": "SMA",
          "period": 50,
          "timeframe": "1d"
        },
        {
          "id": "R",
          "type": "RSI",
          "period": 4
        }
      ]
    },
    "entryRules": {
      "operator": "ALL",
      "conditions": [
