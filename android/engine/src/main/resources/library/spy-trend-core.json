  "plan": {
    "schemaVersion": "1.0",
    "metadata": {
      "name": "S&P 500 trend core",
      "assetClass": "US_EQUITY",
      "timeframe": "1d",
      "createdBy": "IMPORTED",
      "direction": "LONG_ONLY",
      "description": "Found in real SPY daily history 1998 to March 2021. Hold SPY while its daily close is above the 200-day average; sell when it closes below and wait in cash. It gives up some return in steady bull markets but sidesteps most of the deep bear markets (2000-2002 and 2008). About 1 in 4 trades wins; the winners are long and large."
    },
    "universe": {
      "symbols": [
        "SPY"
      ]
    },
    "dataRequirements": {
      "minimumHistoryBars": 60,
      "maximumQuoteAgeSeconds": 3600,
      "indicators": [
        {
          "id": "TREND",
          "type": "SMA",
          "period": 200
        }
      ]
    },
    "entryRules": {
      "operator": "ALL",
      "conditions": [
        {
          "left": "CLOSE",
          "comparison": "GT",
          "right": "TREND"
        }
      ]
    },
    "exitRules": {
      "stopLossPercent": 25,
      "takeProfitPercent": 500,
      "maximumHoldingBars": 1000,
      "conditions": {
        "operator": "ANY",
        "conditions": [
          {
            "left": "CLOSE",
            "comparison": "LT",
            "right": "TREND"
          }
        ]
      }
    },
    "positionSizing": {
      "method": "PERCENT_OF_EQUITY",
      "value": 95
    },
    "orderInstructions": {
      "orderType": "MARKET",
      "timeInForce": "GTC"
    },
    "riskLimits": {
      "maximumOpenPositions": 1,
      "maximumDailyTrades": 5,
      "maximumDailyLossPercent": 10,
      "maximumDrawdownPercent": 60,
      "maximumPositionPercent": 100,
