  "plan": {
    "schemaVersion": "1.0",
    "metadata": {
      "name": "Large-cap dip score",
      "assetClass": "US_EQUITY",
      "timeframe": "1d",
      "createdBy": "IMPORTED",
      "direction": "LONG_ONLY",
      "description": "The dip score spread over 31 large US stocks, found in real daily data (1998-2021 for the rule, 2015-2026 for this universe). While a stock closes above its 50-day average, buy it when at least 2 of 4 oversold signals agree: the 2-day RSI under 10, the close in the bottom 20% of the day's range, the close under the lower Bollinger band (20, 2), and a 10-day closing low. Sell when the close is back above the 5-day average, after 20 days at most, or at a 15% stop. Up to 5 positions at about 19% of equity each. About 2 in 3 trades win."
    },
