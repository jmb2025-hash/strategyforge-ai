    "dataRequirements": {
      "minimumHistoryBars": 60,
      "maximumQuoteAgeSeconds": 3600,
      "indicators": [
        {
          "id": "TREND",
          "type": "SMA",
          "period": 50
        },
        {
          "id": "R",
          "type": "RSI",
          "period": 2
        },
        {
          "id": "IBS20",
          "type": "LEVEL",
          "from": "LOW",
          "to": "HIGH",
          "ratio": 0.2
        },
        {
          "id": "BB",
          "type": "BOLLINGER_BANDS",
          "period": 20,
          "standardDeviations": 2
        },
        {
          "id": "LOW10",
          "type": "LOWEST",
          "period": 10,
          "source": "CLOSE"
        },
        {
          "id": "EXIT",
          "type": "SMA",
          "period": 5
        }
      ]
    },
    "entryRules": {
      "operator": "ALL",
      "conditions": [
        {
          "left": "CLOSE",
          "comparison": "GT",
          "right": "TREND"
        },
        {
          "operator": "AT_LEAST",
          "count": 2,
          "conditions": [
            {
              "left": "R",
              "comparison": "LT",
              "right": 10
            },
            {
              "left": "CLOSE",
              "comparison": "LT",
              "right": "IBS20"
            },
            {
              "left": "CLOSE",
              "comparison": "LT",
              "right": "BB.lower"
            },
            {
              "left": "CLOSE",
              "comparison": "LTE",
              "right": "LOW10"
            }
          ]
        }
      ]
    },
    "exitRules": {
      "stopLossPercent": 15,
      "takeProfitPercent": 30,
      "maximumHoldingBars": 20,
      "conditions": {
        "operator": "ANY",
        "conditions": [
          {
            "left": "CLOSE",
            "comparison": "GT",
            "right": "EXIT"
          }
        ]
      }
    },
    "positionSizing": {
      "method": "PERCENT_OF_EQUITY",
      "value": 19
    },
