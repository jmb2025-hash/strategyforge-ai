# StrategyForge AI environment template (Appendix C). Copy to .env and fill in.
# NEVER commit .env. Generate keys with: scripts/generate-secrets.sh
DATABASE_URL=jdbc:postgresql://db:5432/strategyforge
DATABASE_USER=
DATABASE_PASSWORD=
# Base64 32-byte key for AES-256-GCM encryption of provider credentials and backups.
MASTER_ENCRYPTION_KEY=
# Base64 key (>=32 bytes) used to sign single-use action tokens.
JWT_SIGNING_KEY=
# Optional: when set, owner bootstrap requires this token (recommended).
SF_BOOTSTRAP_TOKEN=
MARKET_PROVIDER=REPLAY
MARKET_API_KEY=
MARKET_API_SECRET=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
FCM_CREDENTIALS_PATH=
DEFAULT_TIMEZONE=America/Halifax
DEFAULT_BASE_CURRENCY=USD
# Must remain false. Any other value prevents the backend from starting.
REAL_MONEY_TRADING_ENABLED=false
# Replay/demo mode: advance the replay clock automatically (true/false).
SF_REPLAY_AUTO_ADVANCE=false
# Optional TLS proxy profile.
SF_TLS_HOSTNAME=
SF_TLS_BIND=127.0.0.1
